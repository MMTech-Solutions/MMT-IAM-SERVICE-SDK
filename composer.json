{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mmt/laravel-iam-service-sdk",
    "type": "library",
    "description": "Laravel SDK for interacting with the MMT IAM Service.",
    "keywords": ["mmt", "laravel", "iam", "sdk"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Mmt\\IamServiceSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mmt\\IamServiceSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmt\\IamServiceSdk\\IamServiceSdkServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
